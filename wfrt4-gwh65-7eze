local Engine = {}
local LEFT_SHIFT = Enum.KeyCode.LeftShift
local keyReferences = {}
local eventQueue = {}
local eventIndex = 1
local heartbeatConnection = nil
local schedulerGeneration = 0

-- Variables de control de pausa en el motor
local isPaused = false
local pauseStart = 0
local totalPausedTime = 0

local function sendKeyEvent(isDown, keyCode)
    pcall(function()
        VirtualInputManager:SendKeyEvent(isDown, keyCode, false, game)
    end)
end

local function acquireKey(keyCode)
    local count = keyReferences[keyCode] or 0
    if count == 0 then
        if not sendKeyEvent(true, keyCode) then return false end
    end
    keyReferences[keyCode] = count + 1
    return true
end

local function releaseKey(keyCode)
    local count = keyReferences[keyCode]
    if not count then return end
    if count <= 1 then
        keyReferences[keyCode] = nil
        sendKeyEvent(false, keyCode)
    else
        keyReferences[keyCode] = count - 1
    end
end

local function pressNote(char)
    local keyCode = keyMappings[char]
    if not keyCode then return nil end
    local needsShift = shiftSet[char] == true
    if needsShift then
        if not sendKeyEvent(true, LEFT_SHIFT) then return nil end
    end
    local acquired = acquireKey(keyCode)
    if needsShift then sendKeyEvent(false, LEFT_SHIFT) end
    if not acquired then return nil end
    return { keyCode = keyCode, active = true }
end

local function releaseNote(handle)
    if not handle or not handle.active then return end
    handle.active = false
    releaseKey(handle.keyCode)
end

local function eventComesFirst(a, b)
    if a.at ~= b.at then return a.at < b.at end
    if a.kind ~= b.kind then return a.kind == "up" end
    return a.order < b.order
end

local function sortEvents(events)
    table.sort(events, function(a, b) return eventComesFirst(a, b) end)
end

-- Funciones de Pausa para el Engine
function Engine.pause()
    if not isPaused then
        isPaused = true
        pauseStart = os.clock()
    end
end

function Engine.resume()
    if isPaused then
        isPaused = false
        totalPausedTime = totalPausedTime + (os.clock() - pauseStart)
        pauseStart = 0
    end
end

local function startScheduler()
    if heartbeatConnection then return end
    local myGeneration = schedulerGeneration

    heartbeatConnection = RunService.Heartbeat:Connect(function()
        if myGeneration ~= schedulerGeneration then return end
        if _G.STOPIT == true then
            Engine.stopAll()
            return
        end

        -- Si está pausado, congelamos el tiempo del motor
        if isPaused then return end

        local now = os.clock() - totalPausedTime

        while true do
            local event = eventQueue[eventIndex]
            if not event or event.at > now then break end
            eventIndex = eventIndex + 1

            if event.kind == "down" then
                event.note.handle = pressNote(event.note.key)
            elseif event.kind == "up" then
                releaseNote(event.note.handle)
                event.note.handle = nil
            end
        end

        if eventIndex > #eventQueue then
            local connection = heartbeatConnection
            heartbeatConnection = nil
            eventQueue = {}
            eventIndex = 1
            if connection then connection:Disconnect() end
        end
    end)
end

local function buildEvents(notes, startAt)
    if type(notes) ~= "table" or #notes == 0 then return nil, "Invalid notes" end
    local events = {}
    local order = 0

    for index, note in ipairs(notes) do
        if not note.key or not keyMappings[note.key] then return nil, "Invalid key" end
        local noteState = { key = note.key, handle = nil }
        local downTime = startAt + note.startSeconds
        local upTime = downTime + note.durationSeconds

        order = order + 1
        table.insert(events, { at = downTime, kind = "down", order = order, note = noteState })
        order = order + 1
        table.insert(events, { at = upTime, kind = "up", order = order, note = noteState })
    end

    sortEvents(events)
    return events
end

function Engine.playNotes(notes, startAt)
    startAt = startAt or (os.clock() + 0.05)
    local pendingEvents, err = buildEvents(notes, startAt)
    if not pendingEvents then return false, err end

    Engine.stopAll()
    eventQueue = pendingEvents
    eventIndex = 1
    startScheduler()
    return true, startAt
end

function Engine.stopAll()
    schedulerGeneration = schedulerGeneration + 1
    if heartbeatConnection then
        heartbeatConnection:Disconnect()
        heartbeatConnection = nil
    end
    eventQueue = {}
    eventIndex = 1
    isPaused = false
    pauseStart = 0
    totalPausedTime = 0

    for keyCode in pairs(keyReferences) do
        sendKeyEvent(false, keyCode)
    end
    keyReferences = {}
    sendKeyEvent(false, LEFT_SHIFT)
    return true
end

return Engine
