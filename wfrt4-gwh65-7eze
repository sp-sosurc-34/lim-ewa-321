
--===================================================================
-- JERKTALENT V18 - INDEPENDENT NOTE SCHEDULER
--===================================================================

local VIM = game:GetService("VirtualInputManager")
local SchedulerRunService = game:GetService("RunService")

local Engine = {}

local SHIFT = Enum.KeyCode.LeftShift

local keyReferences = {}
local eventQueue = {}
local eventIndex = 1

local heartbeatConnection = nil
local generation = 0

--===================================================================
-- 1. ENVÍO SEGURO DE EVENTOS
--===================================================================

local function sendKeyEvent(isDown, keyCode)

    local success, err = pcall(function()

        VIM:SendKeyEvent(
            isDown,
            keyCode,
            false,
            game
        )

    end)

    if not success then
        warn("[JerkTalent V18] KeyEvent:", err)
    end

    return success

end

--===================================================================
-- 2. REFERENCIAS DE TECLAS
--===================================================================

local function acquireKey(keyCode)

    local count = keyReferences[keyCode] or 0

    if count == 0 then

        if not sendKeyEvent(true, keyCode) then
            return false
        end

    end

    keyReferences[keyCode] = count + 1

    return true

end

local function releaseKey(keyCode)

    local count = keyReferences[keyCode]

    if not count then
        return
    end

    if count <= 1 then

        keyReferences[keyCode] = nil
        sendKeyEvent(false, keyCode)

    else

        keyReferences[keyCode] = count - 1

    end

end

--===================================================================
-- 3. PULSACIÓN Y LIBERACIÓN INDIVIDUAL
--===================================================================

local function pressNote(char)

    local keyCode = keyMappings[char]

    if not keyCode then
        return nil
    end

    local needsShift = shiftSet[char] == true

    if needsShift then

        if not acquireKey(SHIFT) then
            return nil
        end

    end

    if not acquireKey(keyCode) then

        if needsShift then
            releaseKey(SHIFT)
        end

        return nil

    end

    return {
        keyCode = keyCode,
        needsShift = needsShift,
        active = true
    }

end

local function releaseNote(handle)

    if not handle or not handle.active then
        return
    end

    handle.active = false

    releaseKey(handle.keyCode)

    if handle.needsShift then
        releaseKey(SHIFT)
    end

end

--===================================================================
-- 4. PARADA Y LIMPIEZA TOTAL
--===================================================================

function Engine.stopAll()

    generation = generation + 1

    eventQueue = {}
    eventIndex = 1

    if heartbeatConnection then

        heartbeatConnection:Disconnect()
        heartbeatConnection = nil

    end

    -- Liberar todas las teclas normales primero.
    for keyCode in pairs(keyReferences) do

        if keyCode ~= SHIFT then
            sendKeyEvent(false, keyCode)
        end

    end

    -- Shift siempre al final.
    if keyReferences[SHIFT] then
        sendKeyEvent(false, SHIFT)
    end

    keyReferences = {}

end

--===================================================================
-- 5. PLANIFICADOR CENTRAL DE EVENTOS
--===================================================================

local function isFinite(value)

    return type(value) == "number"
        and value == value
        and value ~= math.huge
        and value ~= -math.huge

end

local function startScheduler()

    if heartbeatConnection then
        return
    end

    local myGeneration = generation

    heartbeatConnection = SchedulerRunService.Heartbeat:Connect(function()

        if generation ~= myGeneration then
            return
        end

        -- Permitir que el sistema externo detenga el motor.
        if _G.STOPIT then

            Engine.stopAll()
            return

        end

        local now = os.clock()

        while true do

            local event = eventQueue[eventIndex]

            if not event or event.at > now then
                break
            end

            eventIndex = eventIndex + 1

            if event.kind == "down" then

                event.note.handle = pressNote(
                    event.note.key
                )

            elseif event.kind == "up" then

                releaseNote(event.note.handle)
                event.note.handle = nil

            end

        end

        -- Cuando no quedan eventos, desconectar el planificador.
        if eventIndex > #eventQueue then

            local connection = heartbeatConnection

            heartbeatConnection = nil
            eventQueue = {}
            eventIndex = 1

            if connection then
                connection:Disconnect()
            end

        end

    end)

end

--===================================================================
-- 6. REPRODUCTOR DE NOTAS INDEPENDIENTES
--===================================================================

-- Cada nota contiene:
-- key
-- startSeconds
-- durationSeconds

function Engine.playNotes(notes, startAt)

    if type(notes) ~= "table" then
        return false, "Invalid note table"
    end

    if #notes == 0 then
        return false, "Empty note table"
    end

    local pendingEvents = {}
    local order = 0

    startAt = startAt or (os.clock() + 0.05)

    if not isFinite(startAt) then
        return false, "Invalid start time"
    end

    -- Validar y construir los eventos antes de iniciar.
    for index, note in ipairs(notes) do

        if type(note) ~= "table" then
            return false, "Invalid note at " .. index
        end

        if type(note.key) ~= "string"
            or #note.key ~= 1
            or not keyMappings[note.key]
        then

            return false, "Invalid key at " .. index

        end

        if not isFinite(note.startSeconds)
            or note.startSeconds < 0
        then

            return false, "Invalid start time at " .. index

        end

        if not isFinite(note.durationSeconds)
            or note.durationSeconds <= 0
        then

            return false, "Invalid duration at " .. index

        end

        local noteState = {
            key = note.key,
            handle = nil
        }

        order = order + 1

        table.insert(pendingEvents, {

            at = startAt + note.startSeconds,
            kind = "down",
            order = order,
            note = noteState

        })

        order = order + 1

        table.insert(pendingEvents, {

            at = startAt
                + note.startSeconds
                + note.durationSeconds,

            kind = "up",
            order = order,
            note = noteState

        })

    end

    -- Orden cronológico.
    -- Si coinciden, procesar primero las nuevas pulsaciones.
    table.sort(pendingEvents, function(a, b)

        if a.at ~= b.at then
            return a.at < b.at
        end

        if a.kind ~= b.kind then
            return a.kind == "down"
        end

        return a.order < b.order

    end)

    -- Cancelar cualquier reproducción anterior.
    Engine.stopAll()

    eventQueue = pendingEvents
    eventIndex = 1

    startScheduler()

    return true, startAt

end

--===================================================================
-- 7. FINAL
--===================================================================

return Engine

