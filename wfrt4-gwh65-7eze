local function preciseWait(seconds)
    local start = os.clock()
    while os.clock() - start < seconds do
        if seconds - (os.clock() - start) > 0.015 then
            RunService.Heartbeat:Wait()
        else
            task.wait()
        end
    end
end

local Engine = {}

function Engine.pressChord(keys, beats, bpm)
    -- Clasificar notas del acorde por requerimiento de hardware (Con Shift vs Sin Shift)
    local shiftNotes = {}
    local normalNotes = {}

    for i = 1, #keys do
        local char = keys:sub(i, i)
        local keyCode = keyMappings[char]
        
        if keyCode then
            if shiftSet[char] then
                table.insert(shiftNotes, keyCode)
            else
                table.insert(normalNotes, keyCode)
            end
        end
    end

    task.spawn(function()
        pcall(function()
            -- 1. Ejecutar primero las notas normales (Sin Shift) si existen
            if #normalNotes > 0 then
                for _, keyCode in ipairs(normalNotes) do
                    VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
                end
            end

            -- 2. Ejecutar notas con Shift de manera aislada para evitar corromper el acorde básico
            if #shiftNotes > 0 then
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.LeftShift, false, game)
                task.wait(0.001) -- Micro-retraso de hardware para asegurar registro del Shift
                for _, keyCode in ipairs(shiftNotes) do
                    VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
                end
            end

            -- Tiempo de espera musical sustentado
            local noteTime = (beats / bpm) * 60
            preciseWait(math.max(0.005, noteTime * 0.8))

            -- 3. Liberar todas las teclas registradas en hardware
            for _, keyCode in ipairs(normalNotes) do
                VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
            end
            for _, keyCode in ipairs(shiftNotes) do
                VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
            end

            -- 4. Apagar Shift al final
            if #shiftNotes > 0 then
                task.wait(0.001)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
            end
        end)
    end)
end

return Engine
