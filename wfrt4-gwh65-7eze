--===================================================================
-- MODULE 2: ENGINE STATE
--===================================================================

local Engine = {}

local LEFT_SHIFT = Enum.KeyCode.LeftShift

-- Number of active notes using each physical key.
local keyReferences = {}

-- Chronological event queue.
local eventQueue = {}
local eventIndex = 1

-- Central Heartbeat connection.
local heartbeatConnection = nil

-- Invalidates previous scheduler executions.
local schedulerGeneration = 0

-- Sequential compatibility cursor.
local sequenceCursor = nil

--===================================================================
-- MODULE 3: VALIDATION
--===================================================================

local function isFiniteNumber(value)

    return type(value) == "number"
        and value == value
        and value ~= math.huge
        and value ~= -math.huge

end

--===================================================================
-- MODULE 4: SAFE KEY INPUT
--===================================================================

local function sendKeyEvent(isDown, keyCode)

    local success, err = pcall(function()

        VirtualInputManager:SendKeyEvent(
            isDown,
            keyCode,
            false,
            game
        )

    end)

    if not success then

        warn("[JerkTalent V18] KeyEvent error:", err)

    end

    return success

end

--===================================================================
-- MODULE 5: KEY REFERENCE MANAGEMENT
--===================================================================

-- Presses a physical key only when its reference count is zero.

local function acquireKey(keyCode)

    local count = keyReferences[keyCode] or 0

    if count == 0 then

        if not sendKeyEvent(true, keyCode) then
            return false
        end

    end

    keyReferences[keyCode] = count + 1

    return true

end

-- Releases a physical key only when its reference count reaches zero.

local function releaseKey(keyCode)

    local count = keyReferences[keyCode]

    if not count then
        return
    end

    if count <= 1 then

        keyReferences[keyCode] = nil

        sendKeyEvent(false, keyCode)

    else

        keyReferences[keyCode] = count - 1

    end

end

--===================================================================
-- MODULE 6: INDIVIDUAL NOTE HANDLING
--===================================================================

local function pressNote(char)

    local keyCode = keyMappings[char]

    if not keyCode then
        return nil
    end

    local needsShift = shiftSet[char] == true

    -- Acquire Shift when required.
    if needsShift then

        if not acquireKey(LEFT_SHIFT) then
            return nil
        end

    end

    -- Acquire the actual note.
    if not acquireKey(keyCode) then

        if needsShift then
            releaseKey(LEFT_SHIFT)
        end

        return nil

    end

    return {

        keyCode = keyCode,

        needsShift = needsShift,

        active = true

    }

end

local function releaseNote(handle)

    if not handle or not handle.active then
        return
    end

    handle.active = false

    releaseKey(handle.keyCode)

    if handle.needsShift then
        releaseKey(LEFT_SHIFT)
    end

end

--===================================================================
-- MODULE 7: EVENT ORDERING
--===================================================================

-- If two events share a timestamp, KEY UP is processed first.
-- This allows a repeated note to be released and retriggered.

local function eventComesFirst(a, b)

    if a.at ~= b.at then
        return a.at < b.at
    end

    if a.kind ~= b.kind then
        return a.kind == "up"
    end

    return a.order < b.order

end

local function sortEvents(events)

    table.sort(events, function(a, b)

        return eventComesFirst(a, b)

    end)

end

--===================================================================
-- MODULE 8: CENTRAL SCHEDULER
--===================================================================

local function startScheduler()

    if heartbeatConnection then
        return
    end

    local myGeneration = schedulerGeneration

    heartbeatConnection = RunService.Heartbeat:Connect(function()

        -- Ignore invalidated scheduler instances.
        if myGeneration ~= schedulerGeneration then
            return
        end

        -- External stop support.
        if _G.STOPIT == true then

            Engine.stopAll()
            return

        end

        local now = os.clock()

        -- Process every event whose scheduled time has arrived.
        while true do

            local event = eventQueue[eventIndex]

            if not event or event.at > now then
                break
            end

            eventIndex = eventIndex + 1

            if event.kind == "down" then

                event.note.handle = pressNote(
                    event.note.key
                )

            elseif event.kind == "up" then

                releaseNote(event.note.handle)

                event.note.handle = nil

            end

        end

        -- Disconnect when the entire queue has been processed.
        if eventIndex > #eventQueue then

            local connection = heartbeatConnection

            heartbeatConnection = nil

            eventQueue = {}
            eventIndex = 1
            sequenceCursor = nil

            if connection then
                connection:Disconnect()
            end

        end

    end)

end

--===================================================================
-- MODULE 9: EVENT GENERATION
--===================================================================

local function buildEvents(notes, startAt)

    if type(notes) ~= "table" then
        return nil, "Notes must be a table"
    end

    if #notes == 0 then
        return nil, "Empty note table"
    end

    if not isFiniteNumber(startAt) then
        return nil, "Invalid start time"
    end

    local events = {}
    local order = 0

    for index, note in ipairs(notes) do

        if type(note) ~= "table" then

            return nil, "Invalid note at index " .. index

        end

        if type(note.key) ~= "string"
            or not keyMappings[note.key]
        then

            return nil, "Invalid key at index " .. index

        end

        if not isFiniteNumber(note.startSeconds)
            or note.startSeconds < 0
        then

            return nil, "Invalid note start at index " .. index

        end

        if not isFiniteNumber(note.durationSeconds)
            or note.durationSeconds <= 0
        then

            return nil, "Invalid note duration at index " .. index

        end

        local noteState = {

            key = note.key,

            handle = nil

        }

        local downTime =
            startAt + note.startSeconds

        local upTime =
            downTime + note.durationSeconds

        order = order + 1

        table.insert(events, {

            at = downTime,

            kind = "down",

            order = order,

            note = noteState

        })

        order = order + 1

        table.insert(events, {

            at = upTime,

            kind = "up",

            order = order,

            note = noteState

        })

    end

    sortEvents(events)

    return events

end

--===================================================================
-- MODULE 10: APPEND EVENTS
--===================================================================

local function appendEvents(newEvents)

    local mergedEvents = {}

    -- Preserve events that have not yet been processed.
    for i = eventIndex, #eventQueue do

        table.insert(
            mergedEvents,
            eventQueue[i]
        )

    end

    -- Add new events.
    for _, event in ipairs(newEvents) do

        table.insert(
            mergedEvents,
            event
        )

    end

    sortEvents(mergedEvents)

    eventQueue = mergedEvents
    eventIndex = 1

    startScheduler()

end

--===================================================================
-- MODULE 11: PLAY INDEPENDENT NOTES
--===================================================================

-- Input format:
--
-- {
--     {
--         key = "A",
--         startSeconds = 0,
--         durationSeconds = 0.5
--     },
--
--     {
--         key = "D",
--         startSeconds = 0,
--         durationSeconds = 1.0
--     }
-- }
--
-- startAt is an absolute os.clock() timestamp.

function Engine.playNotes(notes, startAt)

    if startAt == nil then
        startAt = os.clock() + 0.05
    end

    -- Validate and construct everything before cancelling
    -- the currently playing sequence.
    local pendingEvents, err = buildEvents(
        notes,
        startAt
    )

    if not pendingEvents then

        warn("[JerkTalent V18] Scheduling rejected:", err)

        return false, err

    end

    -- Replace any previous playback.
    Engine.stopAll()

    eventQueue = pendingEvents
    eventIndex = 1

    startScheduler()

    return true, startAt

end

--===================================================================
-- MODULE 12: LEGACY pressChord COMPATIBILITY
--===================================================================

-- Allows older scripts to continue using pressChord().
-- Consecutive calls are scheduled sequentially without blocking.

function Engine.pressChord(keys, beats, bpm)

    if type(keys) ~= "string" then
        return false, "Invalid chord"
    end

    if not isFiniteNumber(beats) or beats <= 0 then
        return false, "Invalid beats"
    end

    if not isFiniteNumber(bpm) or bpm <= 0 then
        return false, "Invalid BPM"
    end

    local durationSeconds = (beats * 60) / bpm

    local notes = {}

    for i = 1, #keys do

        local char = keys:sub(i, i)

        if not keyMappings[char] then

            return false, "Unknown key: " .. char

        end

        table.insert(notes, {

            key = char,

            startSeconds = 0,

            durationSeconds = durationSeconds

        })

    end

    if #notes == 0 then
        return false, "Empty chord"
    end

    local now = os.clock() + 0.05

    local startAt = math.max(
        now,
        sequenceCursor or now
    )

    local pendingEvents, err = buildEvents(
        notes,
        startAt
    )

    if not pendingEvents then
        return false, err
    end

    appendEvents(pendingEvents)

    sequenceCursor = startAt + durationSeconds

    return true, startAt

end

--===================================================================
-- MODULE 13: STOP ALL AND EMERGENCY CLEANUP
--===================================================================

function Engine.stopAll()

    -- Invalidate the current scheduler.
    schedulerGeneration = schedulerGeneration + 1

    -- Disconnect the central Heartbeat.
    if heartbeatConnection then

        heartbeatConnection:Disconnect()

        heartbeatConnection = nil

    end

    -- Cancel every pending event.
    eventQueue = {}
    eventIndex = 1

    sequenceCursor = nil

    -- Release all normal keys first.
    for keyCode in pairs(keyReferences) do

        if keyCode ~= LEFT_SHIFT then

            sendKeyEvent(false, keyCode)

        end

    end

    -- Always release Shift last.
    if keyReferences[LEFT_SHIFT] then

        sendKeyEvent(false, LEFT_SHIFT)

    end

    -- Reset all references.
    keyReferences = {}

    return true

end

--===================================================================
-- MODULE 14: STATUS
--===================================================================

function Engine.isPlaying()

    return heartbeatConnection ~= nil

end

