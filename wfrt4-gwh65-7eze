local VirtualInputManager = game:GetService("VirtualInputManager")
local RunService = game:GetService("RunService")

-- Lista exhaustiva de caracteres que REQUIEREN activar Shift en un teclado estándar de Roblox
local shiftKeys = {
    "~", "!", "@", "#", "$", "%", "^", "&", "*", "(", ")",
    "_", "+", "{", "}", "|", ":", '"', "<", ">", "?",
    "Q","W","E","R","T","Y","U","I","O","P",
    "A","S","D","F","G","H","J","K","L",
    "Z","X","C","V","B","N","M"
}

-- Conjunto optimizado para búsquedas ultra rápidas O(1)
local shiftSet = {}
for _, key in ipairs(shiftKeys) do
    shiftSet[key] = true
end

-- Mapeo absoluto de hardware (Incluye variaciones de comillas, caracteres latinos comunes y símbolos alternos)
