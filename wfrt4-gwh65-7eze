local function safeWait(seconds)
    local start = os.clock()
    while os.clock() - start < seconds do
        RunService.Heartbeat:Wait()
    end
end

local Engine = {}

function Engine.pressChord(keys, beats, bpm)
    local needsShift = false
    for i = 1, #keys do
        if shiftSet[keys:sub(i, i)] then
            needsShift = true
            break
        end
    end

    pcall(function()
        if needsShift then
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.LeftShift, false, game)
        end

        local activeCodes = {}
        for i = 1, #keys do
            local char = keys:sub(i, i)
            local keyCode = keyMappings[char]
            if keyCode then
                table.insert(activeCodes, keyCode)
                VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
            end
        end

        -- Duración precisa y ligera para proteger la secuencia de la GUI y mantener 100% de armonía
        local noteTime = (beats / bpm) * 60
        local holdDuration = math.clamp(noteTime * 0.50, 0.015, 0.06)
        
        safeWait(holdDuration)

        for _, keyCode in ipairs(activeCodes) do
            VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
        end

        if needsShift then
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
        end
    end)
end

function Engine.stopAll()
    pcall(function()
        for _, keyCode in pairs(keyMappings) do
            VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
        end
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
    end)
end

return Engine
