--===================================================================
-- MODULE 2: ENGINE STATE
--===================================================================

local Engine = {}

local LEFT_SHIFT = Enum.KeyCode.LeftShift

local keyReferences = {}

local eventQueue = {}
local eventIndex = 1

local heartbeatConnection = nil

local schedulerGeneration = 0
local sequenceCursor = nil

--===================================================================
-- MODULE 3: VALIDATION
--===================================================================

local function isFiniteNumber(value)

    return type(value) == "number"
        and value == value
        and value ~= math.huge
        and value ~= -math.huge

end

--===================================================================
-- MODULE 4: SAFE INPUT
--===================================================================

local function sendKeyEvent(isDown, keyCode)

    local success, err = pcall(function()

        VirtualInputManager:SendKeyEvent(
            isDown,
            keyCode,
            false,
            game
        )

    end)

    if not success then

        warn("[JerkTalent V19] Input error:", err)

    end

    return success

end

--===================================================================
-- MODULE 5: PHYSICAL KEY REFERENCES
--===================================================================

local function acquireKey(keyCode)

    local count = keyReferences[keyCode] or 0

    if count == 0 then

        if not sendKeyEvent(true, keyCode) then
            return false
        end

    end

    keyReferences[keyCode] = count + 1

    return true

end

local function releaseKey(keyCode)

    local count = keyReferences[keyCode]

    if not count then
        return
    end

    if count <= 1 then

        keyReferences[keyCode] = nil

        sendKeyEvent(false, keyCode)

    else

        keyReferences[keyCode] = count - 1

    end

end

--===================================================================
-- MODULE 6: INDIVIDUAL NOTE HANDLING
--===================================================================

local function pressNote(char)

    local keyCode = keyMappings[char]

    if not keyCode then

        warn("[JerkTalent V19] Unknown key:", char)

        return nil

    end

    local needsShift = shiftSet[char] == true

    -- Shift is used only for the key-down operation.
    -- It is released immediately to avoid affecting other notes.

    if needsShift then

        if not sendKeyEvent(true, LEFT_SHIFT) then
            return nil
        end

    end

    local acquired = acquireKey(keyCode)

    if needsShift then

        sendKeyEvent(false, LEFT_SHIFT)

    end

    if not acquired then
        return nil
    end

    return {

        keyCode = keyCode,

        active = true

    }

end

local function releaseNote(handle)

    if not handle or not handle.active then
        return
    end

    handle.active = false

    releaseKey(handle.keyCode)

end

--===================================================================
-- MODULE 7: EVENT ORDERING
--===================================================================

local function eventComesFirst(a, b)

    if a.at ~= b.at then
        return a.at < b.at
    end

    -- Release the previous note before retriggering it.
    if a.kind ~= b.kind then
        return a.kind == "up"
    end

    return a.order < b.order

end

local function sortEvents(events)

    table.sort(events, function(a, b)

        return eventComesFirst(a, b)

    end)

end

--===================================================================
-- MODULE 8: CENTRAL HEARTBEAT SCHEDULER
--===================================================================

local function startScheduler()

    if heartbeatConnection then
        return
    end

    local myGeneration = schedulerGeneration

    heartbeatConnection = RunService.Heartbeat:Connect(function()

        if myGeneration ~= schedulerGeneration then
            return
        end

        if _G.STOPIT == true then

            Engine.stopAll()
            return

        end

        local now = os.clock()

        while true do

            local event = eventQueue[eventIndex]

            if not event or event.at > now then
                break
            end

            eventIndex = eventIndex + 1

            if event.kind == "down" then

                event.note.handle = pressNote(
                    event.note.key
                )

            elseif event.kind == "up" then

                releaseNote(event.note.handle)

                event.note.handle = nil

            end

        end

        if eventIndex > #eventQueue then

            local connection = heartbeatConnection

            heartbeatConnection = nil

            eventQueue = {}
            eventIndex = 1
            sequenceCursor = nil

            if connection then
                connection:Disconnect()
            end

        end

    end)

end

--===================================================================
-- MODULE 9: EVENT GENERATION
--===================================================================

local function buildEvents(notes, startAt)

    if type(notes) ~= "table" then
        return nil, "Notes must be a table"
    end

    if #notes == 0 then
        return nil, "Empty note table"
    end

    if not isFiniteNumber(startAt) then
        return nil, "Invalid start time"
    end

    local events = {}
    local order = 0

    for index, note in ipairs(notes) do

        if type(note) ~= "table" then
            return nil, "Invalid note at index " .. index
        end

        if type(note.key) ~= "string"
            or not keyMappings[note.key]
        then

            return nil, "Invalid key at index " .. index

        end

        if not isFiniteNumber(note.startSeconds)
            or note.startSeconds < 0
        then

            return nil, "Invalid start time at index " .. index

        end

        if not isFiniteNumber(note.durationSeconds)
            or note.durationSeconds <= 0
        then

            return nil, "Invalid duration at index " .. index

        end

        local noteState = {

            key = note.key,

            handle = nil

        }

        local downTime =
            startAt + note.startSeconds

        local upTime =
            downTime + note.durationSeconds

        order = order + 1

        table.insert(events, {

            at = downTime,
            kind = "down",
            order = order,
            note = noteState

        })

        order = order + 1

        table.insert(events, {

            at = upTime,
            kind = "up",
            order = order,
            note = noteState

        })

    end

    sortEvents(events)

    return events

end

--===================================================================
-- MODULE 10: QUEUE MANAGEMENT
--===================================================================

local function appendEvents(newEvents)

    local mergedEvents = {}

    for i = eventIndex, #eventQueue do

        table.insert(
            mergedEvents,
            eventQueue[i]
        )

    end

    for _, event in ipairs(newEvents) do

        table.insert(
            mergedEvents,
            event
        )

    end

    sortEvents(mergedEvents)

    eventQueue = mergedEvents
    eventIndex = 1

    startScheduler()

end

--===================================================================
-- MODULE 11: INDEPENDENT NOTE PLAYER
--===================================================================

-- Each note:
-- key
-- startSeconds
-- durationSeconds

function Engine.playNotes(notes, startAt)

    if startAt == nil then
        startAt = os.clock() + 0.05
    end

    local pendingEvents, err = buildEvents(
        notes,
        startAt
    )

    if not pendingEvents then

        warn("[JerkTalent V19] Scheduling rejected:", err)

        return false, err

    end

    Engine.stopAll()

    eventQueue = pendingEvents
    eventIndex = 1

    startScheduler()

    return true, startAt

end

--===================================================================
-- MODULE 12: LEGACY pressChord SUPPORT
--===================================================================

function Engine.pressChord(keys, beats, bpm)

    if type(keys) ~= "string" then
        return false, "Invalid chord"
    end

    if not isFiniteNumber(beats) or beats <= 0 then
        return false, "Invalid beats"
    end

    if not isFiniteNumber(bpm) or bpm <= 0 then
        return false, "Invalid BPM"
    end

    local durationSeconds = beats * 60 / bpm

    local notes = {}

    for i = 1, #keys do

        local char = keys:sub(i, i)

        if not keyMappings[char] then
            return false, "Unknown key: " .. char
        end

        table.insert(notes, {

            key = char,

            startSeconds = 0,

            durationSeconds = durationSeconds

        })

    end

    if #notes == 0 then
        return false, "Empty chord"
    end

    local now = os.clock() + 0.05

    local startAt = math.max(
        now,
        sequenceCursor or now
    )

    local pendingEvents, err = buildEvents(
        notes,
        startAt
    )

    if not pendingEvents then
        return false, err
    end

    appendEvents(pendingEvents)

    sequenceCursor = startAt + durationSeconds

    return true, startAt

end

--===================================================================
-- MODULE 13: EMERGENCY CLEANUP
--===================================================================

function Engine.stopAll()

    schedulerGeneration = schedulerGeneration + 1

    if heartbeatConnection then

        heartbeatConnection:Disconnect()

        heartbeatConnection = nil

    end

    eventQueue = {}
    eventIndex = 1

    sequenceCursor = nil

    -- Release every active normal key.
    for keyCode in pairs(keyReferences) do

        sendKeyEvent(false, keyCode)

    end

    keyReferences = {}

    -- Ensure Shift is never left held.
    sendKeyEvent(false, LEFT_SHIFT)

    return true

end

--===================================================================
-- MODULE 14: STATUS
--===================================================================

function Engine.isPlaying()

    return heartbeatConnection ~= nil

end

